# Required for live OpenRouter calls. Offline pytest does not need this.
OPENROUTER_API_KEY=

# Defaults used by live runs.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
OPENROUTER_MODEL_A=nvidia/nemotron-3.5-lightning
OPENROUTER_MODEL_B=openai/gpt-4o-mini
MODEL_A=nvidia/nemotron-3.5-lightning
MODEL_B=openai/gpt-4o-mini
CAESAR_MODEL=nvidia/nemotron-3.5-lightning

# Attribution headers OpenRouter recommends. Not used for auth.
OPENROUTER_HTTP_REFERER=https://github.com/duketopceo
OPENROUTER_TITLE=openrouter-demos

# Set to 1 to hit the live API. Default is offline fixtures.
RUN_LIVE=0
